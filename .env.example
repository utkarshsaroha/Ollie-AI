# --- Backend (LiteLLM / FastAPI) ---
# LiteLLM-style "provider/model" string. Any model LiteLLM supports works.
LLM_MODEL=gemini/gemini-2.0-flash

# At least 2 comma-separated API keys, in priority order (key_1, key_2, ...).
# All keys authenticate against the SAME provider/model above.
LLM_API_KEYS=your-first-gemini-api-key,your-second-gemini-api-key

# sqlite:///<path>. In Docker this is mounted to the named volume at /data.
DATABASE_URL=sqlite:////data/app.db

# Enables the X-Simulate-Failure test header on POST /chat. Keep true for grading/demo,
# set false in a real production deployment.
ENABLE_FAILURE_SIMULATION=true

# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:3000

CACHE_ENABLED=true

DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# --- Frontend (Vite) ---
# Baked in at build time. Point this at your deployed backend in production.
VITE_API_BASE_URL=http://localhost:8000
